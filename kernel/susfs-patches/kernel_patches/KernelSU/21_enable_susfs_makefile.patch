+ccflags-y += -DKSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG
+endif
+ifneq ($(CONFIG_KSU_SUSFS_OPEN_REDIRECT),)
+ccflags-y += -DKSU_SUSFS_OPEN_REDIRECT
